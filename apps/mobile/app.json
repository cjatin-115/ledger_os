{
  "expo": {
    "name": "ledgeros-mobile",
    "slug": "ledgeros-mobile",
    "version": "0.1.0",
    "scheme": "ledgeros",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LedgerOS to access your photos to attach bill images.",
          "cameraPermission": "Allow LedgerOS to use the camera to scan invoices."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    },
    "android": {
      "package": "com.ledgeros.mobile"
    }
  }
}

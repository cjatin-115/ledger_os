{
  "expo": {
    "name": "ledgeros-mobile",
    "slug": "flova",
    "version": "0.1.0",
    "scheme": "ledgeros",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LedgerOS to access your photos to attach bill images.",
          "cameraPermission": "Allow LedgerOS to use the camera to scan invoices."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "297b925b-92c4-4c2b-b165-bbbfe7189ca1"
      }
    },
    "owner": "flova",
    "android": {
      "package": "com.flova.flova"
    }
  }
}
